#!/bin/bash
# pw-run <file.js>: runs a Node (Playwright) script in the Playwright container. Used by condition C3 only.
# - the script must be in the run's working directory ($PWRUN_DIR), mounted read/write on /work;
# - require('playwright') (1.64.1) is available; there is no other writable mount;
# - internal network with no route to the Internet; only localhost:8099 is relayed to the test page;
# - 2 GB of memory, 2 CPUs, 150 s at most; output truncated to 30,000 bytes.
# Environment: PWRUN_DIR (required, set by run-one.sh), plus the variables of harness/env.sh.
HARNESS="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$HARNESS/env.sh"
WORK="${PWRUN_DIR:?PWRUN_DIR is not set}"
[ $# -eq 1 ] || { echo "usage: pw-run <file.js>" >&2; exit 2; }
f="$1"; case "$f" in /work/*) f="$WORK/${f#/work/}";; /*) ;; *) f="$WORK/$f";; esac
f="$(realpath -e -- "$f" 2>/dev/null)" || { echo "pw-run: file not found" >&2; exit 2; }
case "$f" in "$WORK"/*.js|"$WORK"/*.mjs|"$WORK"/*.cjs) ;; *) echo "pw-run: the script must be a .js file in $WORK" >&2; exit 2;; esac
rel="${f#$WORK/}"
docker run --rm --init --user "$DOCKER_USER" --network exp-int --shm-size=1g --memory 2g --cpus 2 \
  -e HOME=/tmp -e NODE_PATH=/pkgs/node_modules \
  -v "$HARNESS":/harness:ro -v "$RUN_DIR/pkgs-pw":/pkgs:ro -v "$WORK":/work -w /work "$IMG" \
  timeout 150 /harness/entry.sh node "/work/$rel" 2>&1 | head -c 30000
exit ${PIPESTATUS[0]}
